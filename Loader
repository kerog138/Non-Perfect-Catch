------------------------------------------------------------
-- CREATE WORKSPACE FOLDER
------------------------------------------------------------

local function ensurePreferencesFolder()
    if type(isfolder) == "function"
        and type(makefolder) == "function" then

        local ok, exists =
            pcall(
                isfolder,
                CONFIG_FOLDER
            )

        if not ok
            or not exists then

            pcall(
                makefolder,
                CONFIG_FOLDER
            )
        end
    elseif type(makefolder) == "function" then

        pcall(
            makefolder,
            CONFIG_FOLDER
        )
    end
end

------------------------------------------------------------
-- LOAD PREFERENCES
------------------------------------------------------------

local function loadPreferences()
    ensurePreferencesFolder()

    if type(isfile) ~= "function"
        or type(readfile) ~= "function" then

        return
    end

    local okExists, exists =
        pcall(
            isfile,
            CONFIG_FILE
        )

    if not okExists
        or not exists then

        return
    end

    local okRead, raw =
        pcall(
            readfile,
            CONFIG_FILE
        )

    if not okRead
        or type(raw) ~= "string"
        or raw == "" then

        return
    end

    local okDecode, decoded =
        pcall(function()

            return HttpService:
                JSONDecode(
                    raw
                )
        end)

    if not okDecode
        or type(decoded) ~= "table" then

        return
    end

    if type(
        decoded.nonPerfectEnabled
    ) == "boolean" then

        Preferences.nonPerfectEnabled =
            decoded.nonPerfectEnabled
    end

    if type(decoded.uiX)
        == "number" then

        Preferences.uiX =
            decoded.uiX
    end

    if type(decoded.uiY)
        == "number" then

        Preferences.uiY =
            decoded.uiY
    end
end

------------------------------------------------------------
-- SAVE PREFERENCES
------------------------------------------------------------

local function savePreferences()
    ensurePreferencesFolder()

    if type(writefile)
        ~= "function" then

        return
    end

    local okEncode, raw =
        pcall(function()

            return HttpService:
                JSONEncode({
                    nonPerfectEnabled =
                        Preferences.nonPerfectEnabled,

                    uiX =
                        Preferences.uiX,

                    uiY =
                        Preferences.uiY
                })
        end)

    if not okEncode
        or not raw then

        return
    end

    pcall(
        writefile,
        CONFIG_FILE,
        raw
    )
end

