------------------------------------------------------------
-- UI HELPERS
------------------------------------------------------------

local function clamp(
    value,
    minimum,
    maximum
)

    if value < minimum then
        return minimum
    end

    if value > maximum then
        return maximum
    end

    return value
end

local function viewport()
    if not Camera then

        Camera =
            Workspace.CurrentCamera
    end

    local size =
        Camera
        and Camera.ViewportSize

    if not size then
        return nil, nil
    end

    return
        size.X,
        size.Y
end

local function uiMouse()
    local x, y =
        mouseXY()

    if x and y then
        return x, y
    end

    return
        -10000,
        -10000
end

local function inside(
    mx,
    my,
    x,
    y,
    width,
    height
)

    return
        mx >= x
        and my >= y
        and mx <= x + width
        and my <= y + height
end

------------------------------------------------------------
-- DRAWING POOL
------------------------------------------------------------

local function square()
    UI.sqUsed =
        UI.sqUsed + 1

    local object =
        UI.squares[
            UI.sqUsed
        ]

    if not object then

        object =
            Drawing.new(
                "Square"
            )

        object.Filled =
            true

        object.ZIndex =
            300

        UI.squares[
            UI.sqUsed
        ] =
            object
    end

    object.Visible =
        true

    return object
end

local function textObject()
    UI.txUsed =
        UI.txUsed + 1

    local object =
        UI.texts[
            UI.txUsed
        ]

    if not object then

        object =
            Drawing.new(
                "Text"
            )

        object.Center =
            false

        object.Outline =
            false

        object.ZIndex =
            302

        if FONT then

            pcall(function()

                object.Font =
                    FONT
            end)
        end

        UI.texts[
            UI.txUsed
        ] =
            object
    end

    object.Visible =
        true

    return object
end

------------------------------------------------------------
-- RECT
------------------------------------------------------------

local function rect(
    x,
    y,
    width,
    height,
    color,
    z
)

    local object =
        square()

    object.Position =
        Vector2.new(
            x,
            y
        )

    object.Size =
        Vector2.new(
            width,
            height
        )

    object.Color =
        color
        or C.panel

    object.Filled =
        true

    object.ZIndex =
        z
        or 300

    return object
end

------------------------------------------------------------
-- LABEL
------------------------------------------------------------

local function label(
    text,
    x,
    y,
    size,
    color,
    centered,
    z
)

    local object =
        textObject()

    object.Text =
        tostring(
            text
            or ""
        )

    object.Position =
        Vector2.new(
            x,
            y
        )

    object.Color =
        color
        or C.text

    object.Center =
        centered == true

    object.ZIndex =
        z
        or 302

    pcall(function()

        object.Size =
            size
            or 14
    end)

    pcall(function()

        object.FontSize =
            size
            or 14
    end)

    return object
end

------------------------------------------------------------
-- FRAME
------------------------------------------------------------

local function beginFrame()
    UI.sqUsed =
        0

    UI.txUsed =
        0
end

local function endFrame()
    for index =
        UI.sqUsed + 1,
        #UI.squares do

        UI.squares[
            index
        ].Visible =
            false
    end

    for index =
        UI.txUsed + 1,
        #UI.texts do

        UI.texts[
            index
        ].Visible =
            false
    end
end

------------------------------------------------------------
-- REMOVE DRAWINGS
------------------------------------------------------------

local function removeUI()
    for _, object in ipairs(
        UI.squares
    ) do

        pcall(function()

            object:
                Remove()
        end)
    end

    for _, object in ipairs(
        UI.texts
    ) do

        pcall(function()

            object:
                Remove()
        end)
    end

    UI.squares =
        {}

    UI.texts =
        {}
end

------------------------------------------------------------
-- CLAMP WINDOW
------------------------------------------------------------

local function clampWindow()
    local vw,
        vh =
        viewport()

    if not vw
        or not vh then

        return
    end

    UI.x =
        clamp(
            UI.x,
            4,
            math.max(
                4,
                vw
                    - UI.w
                    - 4
            )
        )

    UI.y =
        clamp(
            UI.y,
            4,
            math.max(
                4,
                vh
                    - UI.h
                    - 4
            )
        )
end

------------------------------------------------------------
-- NORMAL TOGGLE
------------------------------------------------------------

local function toggleWidget(
    mx,
    my,
    pressed,
    x,
    y,
    width,
    text,
    value,
    callback
)

    local hover =
        inside(
            mx,
            my,
            x,
            y,
            width,
            30
        )

    rect(
        x,
        y,
        width,
        30,

        hover
            and C.panel2
            or C.panel
    )

    rect(
        x
            + width
            - 43,

        y + 7,

        31,
        16,

        value
            and C.good
            or C.stroke
    )

    rect(
        x
            + width
            - (
                value
                and 23
                or 39
            ),

        y + 9,

        12,
        12,

        C.white,
        303
    )

    label(
        text,

        x + 10,
        y + 7,

        14,

        C.text
    )

    if hover
        and pressed then

        callback(
            not value
        )
    end
end

