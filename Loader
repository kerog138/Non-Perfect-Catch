------------------------------------------------------------
-- RAW KEY CHECK
------------------------------------------------------------

local function rawKeyDown(key)
    if type(iskeypressed)
        == "function" then

        local ok, state =
            pcall(
                iskeypressed,
                key
            )

        if ok and state then
            return true
        end
    end

    if type(isKeyPressed)
        == "function" then

        local ok, state =
            pcall(
                isKeyPressed,
                key
            )

        if ok and state then
            return true
        end
    end

    if type(input)
        == "table" then

        if type(input.iskeypressed)
            == "function" then

            local ok, state =
                pcall(
                    input.iskeypressed,
                    key
                )

            if ok and state then
                return true
            end
        end

        if type(input.is_key_pressed)
            == "function" then

            local ok, state =
                pcall(
                    input.is_key_pressed,
                    key
                )

            if ok and state then
                return true
            end
        end
    end

    return false
end

