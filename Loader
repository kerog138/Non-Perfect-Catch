local activeInjectedKeys = {}

local function tapKey(
    keyCode,
    holdMilliseconds
)

    if destroyed
        or not running then

        return false
    end

    if not isRobloxActive() then
        return false
    end

    if type(keypress) ~= "function"
        or type(keyrelease) ~= "function" then

        return false
    end

    if activeInjectedKeys[
        keyCode
    ] then

        return false
    end

    activeInjectedKeys[
        keyCode
    ] =
        true

    task.spawn(function()

        pcall(function()

            keypress(
                keyCode
            )
        end)

        task.wait(
            (holdMilliseconds or 30)
            / 1000
        )

        pcall(function()

            keyrelease(
                keyCode
            )
        end)

        activeInjectedKeys[
            keyCode
        ] =
            nil
    end)

    return true
end

