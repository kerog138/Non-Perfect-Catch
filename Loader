task.spawn(function()

    while running
        and not destroyed do

        ----------------------------------------------------
        -- INPUT
        ----------------------------------------------------

        local held =
            mouseDown()

        local pressed =
            held
            and not UI.lastMouse

        UI.lastMouse =
            held

        local keyX =
            xDown()

        local xPressed =
            keyX
            and not UI.lastX

        UI.lastX =
            keyX

        if xPressed then

            toggleNonPerfect()
        end

        ----------------------------------------------------
        -- MOUSE
        ----------------------------------------------------

        local mx,
            my =
            uiMouse()

        clampWindow()

        local headerHover =
            inside(
                mx,
                my,

                UI.x,
                UI.y,

                UI.w,
                36
            )

        local closeHover =
            inside(
                mx,
                my,

                UI.x
                    + UI.w
                    - 35,

                UI.y + 5,

                28,
                26
            )

        ----------------------------------------------------
        -- CLOSE
        ----------------------------------------------------

        if pressed
            and closeHover then

            local destroy =
                _G.KeroFishingHelpersDestroy

            if destroy then

                destroy()
            end

            return
        end

        ----------------------------------------------------
        -- START DRAG
        ----------------------------------------------------

        if pressed
            and headerHover
            and not closeHover then

            UI.dragging =
                true

            UI.dragDX =
                mx - UI.x

            UI.dragDY =
                my - UI.y
        end

        ----------------------------------------------------
        -- DRAG UPDATE
        ----------------------------------------------------

        if UI.dragging then

            if held then

                UI.x =
                    mx
                    - UI.dragDX

                UI.y =
                    my
                    - UI.dragDY

                clampWindow()

            else

                UI.dragging =
                    false

                ------------------------------------------------
                -- SAVE LOCATION ON DRAG RELEASE
                ------------------------------------------------

                Preferences.uiX =
                    UI.x

                Preferences.uiY =
                    UI.y

                savePreferences()
            end
        end

        ----------------------------------------------------
        -- DRAW
        ----------------------------------------------------

        beginFrame()

        ----------------------------------------------------
        -- WINDOW
        ----------------------------------------------------

        rect(
            UI.x,
            UI.y,

            UI.w,
            UI.h,

            C.bg,
            300
        )

        ----------------------------------------------------
        -- HEADER
        ----------------------------------------------------

        rect(
            UI.x,
            UI.y,

            UI.w,
            36,

            C.panel2,
            301
        )

        rect(
            UI.x,
            UI.y + 35,

            UI.w,
            1,

            C.stroke,
            302
        )

        ----------------------------------------------------
        -- TITLE
        ----------------------------------------------------

        label(
            "FISCH",

            UI.x + 13,
            UI.y + 9,

            15,

            C.text,
            false,
            304
        )

        ----------------------------------------------------
        -- CLOSE
        ----------------------------------------------------

        rect(
            UI.x
                + UI.w
                - 35,

            UI.y + 5,

            28,
            26,

            closeHover
                and C.bad
                or C.panel,

            303
        )

        label(
            "X",

            UI.x
                + UI.w
                - 21,

            UI.y + 15,

            15,

            C.text,
            true,
            304
        )

        ----------------------------------------------------
        -- CONTENT
        ----------------------------------------------------

        local x =
            UI.x + 12

        local y =
            UI.y + 51

        local width =
            UI.w - 24

        ----------------------------------------------------
        -- FORCE NON PERFECT
        ----------------------------------------------------

        toggleWidget(
            mx,
            my,
            pressed,

            x,
            y,
            width,

            "Force Non-Perfect Catch",

            NonPerfect.enabled,

            setNonPerfect
        )

        label(
