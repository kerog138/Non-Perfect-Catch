------------------------------------------------------------
-- NOTE Y
------------------------------------------------------------

local function readNoteY(
    note,
    lane
)

    do

        local ok, value =
            pcall(function()

                return
                    note.Position.Y.Scale
            end)

        if ok
            and type(value)
                == "number"
            and value > -2
            and value < 2 then

            return
                value,
                "Position"
        end
    end

    do

        local ok, value =
            pcall(function()

                local notePosition =
                    note.AbsolutePosition

                local noteSize =
                    note.AbsoluteSize

                local lanePosition =
                    lane.AbsolutePosition

                local laneSize =
                    lane.AbsoluteSize

                if not notePosition
                    or not noteSize
                    or not lanePosition
                    or not laneSize then

                    return nil
                end

                if laneSize.Y
                    <= 1 then

                    return nil
                end

                local noteCenterY =
                    notePosition.Y
                    + (
                        noteSize.Y
                        / 2
                    )

                return (
                    noteCenterY
                    - lanePosition.Y
                )
                    / laneSize.Y
            end)

        if ok
            and type(value)
                == "number"
            and value > -2
            and value < 2 then

            return
                value,
                "Absolute"
        end
    end

    return nil,
        "Unreadable"
end

------------------------------------------------------------
-- TAP TRANQUILITY LANE
------------------------------------------------------------

local function tapLane(
    laneIndex
)

    local keyCode =
        LANE_KEYS[
            laneIndex
        ]

    if not keyCode then
        return false
    end

    if tapKey(
        keyCode,
        30
    ) then

        Tranquility.presses =
            Tranquility.presses
            + 1

        Tranquility.lastKey =
            LANE_NAMES[
                laneIndex
            ]

        return true
    end

    return false
end

------------------------------------------------------------
-- UPDATE TRANQUILITY
------------------------------------------------------------

local function updateTranquility()
    local context,
        status =
        tranquilityContext()

    Tranquility.status =
        status

    Tranquility.notesSeen =
        0

    Tranquility.lastY =
        nil

    Tranquility.lastSource =
        "None"

    if not context then
        return
    end

    local alive = {}

    for laneIndex = 1, 4 do

        local lane =
            context.lanes[
                laneIndex
            ]

        local ok, list =
            pcall(function()

                return
                    lane:
                    GetChildren()
            end)

        if ok and list then

            for _, note in ipairs(
                list
            ) do

                if isRhythmNote(
                    note
                ) then

                    Tranquility.notesSeen =
                        Tranquility.notesSeen
                        + 1

                    local id =
                        noteId(
                            note
                        )

                    alive[id] =
                        true

                    local y,
                        source =
                        readNoteY(
                            note,
                            lane
                        )

                    if type(y)
                        == "number" then

                        if Tranquility.lastY
                            == nil
                            or y
                                > Tranquility.lastY then

                            Tranquility.lastY =
                                y

                            Tranquility.lastSource =
                                source
                        end

                        if not Tranquility.hitNotes[
                            id
                        ] then

                            local previous =
                                Tranquility.oldY[
                                    id
                                ]

                            Tranquility.oldY[
                                id
                            ] =
                                y

                            local insideWindow =
                                y
                                    >= Tranquility.HIT_MIN

                                and y
                                    <= Tranquility.HIT_MAX

                            local crossedWindow =
                                previous
                                    ~= nil

                                and previous
                                    < Tranquility.HIT_MIN

                                and y
                                    > Tranquility.HIT_MAX

                                and y
                                    < 1.08

                            if insideWindow
                                or crossedWindow then

                                if tapLane(
                                    laneIndex
                                ) then

                                    Tranquility.hitNotes[
                                        id
                                    ] =
                                        true
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for id in pairs(
        Tranquility.hitNotes
    ) do

        if not alive[id] then

            Tranquility.hitNotes[
                id
            ] =
                nil
        end
    end

    for id in pairs(
        Tranquility.oldY
    ) do

        if not alive[id] then

            Tranquility.oldY[
                id
            ] =
                nil
        end
    end
end

