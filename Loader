------------------------------------------------------------
-- START NON PERFECT
------------------------------------------------------------

local function startNonPerfect()
    if type(getgc)
        ~= "function"
        or type(applygc)
            ~= "function" then

        return false
    end

    if NonPerfect.worker then

        pcall(function()

            NonPerfect.worker:
                Disconnect()
        end)

        NonPerfect.worker =
            nil
    end

    NonPerfect.generation =
        NonPerfect.generation
        + 1

    local generation =
        NonPerfect.generation

    NonPerfect.lastWrite =
        0

    if not NonPerfect.cache then

        NonPerfect.lastSearch =
            0

        task.spawn(function()

            findPerfectCache(
                true
            )
        end)
    end

    NonPerfect.worker =
        RunService.Heartbeat:
        Connect(function()

            if destroyed
                or not running
                or not NonPerfect.enabled then

                return
            end

            if generation
                ~= NonPerfect.generation then

                return
            end

            if not reelActive()
                or harpoonActive() then

                NonPerfect.active =
                    false

                return
            end

            if not NonPerfect.cache then

                NonPerfect.active =
                    false

                findPerfectCache(
                    false
                )

                return
            end

            if readPerfect()
                == false then

                NonPerfect.active =
                    true

                return
            end

            local now =
                clock()

            if now
                - NonPerfect.lastWrite
                >= 0.1 then

                NonPerfect.lastWrite =
                    now

                if writePerfect(
                    false
                ) then

                    NonPerfect.active =
                        true
                end
            end
        end)

    return true
end

------------------------------------------------------------
-- SET NON PERFECT
------------------------------------------------------------

local function setNonPerfect(
    value,
    silent
)

    if destroyed
        or not running then

        return
    end

    value =
        value == true

    if NonPerfect.enabled
        == value then

        return
    end

    if value then

        NonPerfect.enabled =
            true

        if not startNonPerfect() then

            NonPerfect.enabled =
                false

            Preferences.nonPerfectEnabled =
                false

            savePreferences()

            if not silent then

                print(
                    "(kero) Force Non-Perfect Catch failed to enable"
                )
            end

            return
        end

        Preferences.nonPerfectEnabled =
            true

        savePreferences()

        if not silent then

            print(
                "(kero) Force Non-Perfect Catch Enabled"
            )
        end

    else

        NonPerfect.enabled =
            false

        stopNonPerfect()

        Preferences.nonPerfectEnabled =
            false

        savePreferences()

        if not silent then

            print(
                "(kero) Force Non-Perfect Catch Disabled"
            )
        end
    end
end

local function toggleNonPerfect()
    setNonPerfect(
        not NonPerfect.enabled,
        false
    )
end

