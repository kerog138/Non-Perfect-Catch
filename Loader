------------------------------------------------------------
-- HARPOON
------------------------------------------------------------

local function harpoonActive()
    local now =
        clock()

    if now
        - NonPerfect.harpoonTime
        < 0.25 then

        return
            NonPerfect.harpoonCache
    end

    NonPerfect.harpoonTime =
        now

    local result =
        false

    pcall(function()

        local character =
            LocalPlayer
            and LocalPlayer.Character

        if character then

            if character:
                GetAttribute(
                    "HarpoonMinigameActive"
                )
                or character:
                    GetAttribute(
                        "HarpoonMinigame"
                    ) then

                result =
                    true

            else

                local tool =
                    character:
                    FindFirstChildOfClass(
                        "Tool"
                    )

                if tool then

                    local name =
                        tool.Name:
                        lower()

                    local harpoon =
                        name:find(
                            "harpoon",
                            1,
                            true
                        )
                        or name:find(
                            "spear",
                            1,
                            true
                        )

                    if harpoon
                        and not name:find(
                            "halibut",
                            1,
                            true
                        ) then

                        result =
                            true
                    end
                end
            end
        end

        if not result then

            local gui =
                getPlayerGui()

            if gui then

                for _, child in ipairs(
                    gui:GetChildren()
                ) do

                    if child:IsA(
                        "ScreenGui"
                    )
                        and child.Enabled
                        and child.Name:
                            lower():
                            find(
                                "harpoonminigame",
                                1,
                                true
                            ) then

                        result =
                            true

                        break
                    end
                end
            end
        end
    end)

    NonPerfect.harpoonCache =
        result

    return result
end

------------------------------------------------------------
-- PERFECT CACHE
------------------------------------------------------------

local function findPerfectCache(
    force
)

    if type(getgc)
        ~= "function" then

        return nil
    end

    local now =
        clock()

    if not force then

        if NonPerfect.cache then

            return
                NonPerfect.cache
        end

        if now
            - NonPerfect.lastSearch
            < 2 then

            return nil
        end
    end

    NonPerfect.lastSearch =
        now

    local ok, result =
        pcall(function()

            return getgc({
                "perfect"
            })
        end)

    if ok
        and result then

        NonPerfect.cache =
            result
    end

    return
        NonPerfect.cache
end

